<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h3 mb-1">Uchrashuvlar</h1>
      <p class="text-muted mb-0">Bemor uchrashuvlarini boshqarish</p>
    </div>
    <a href="/appointments/new" class="btn btn-primary">Yangi uchrashuv</a>
  </div>

  <% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="card shadow-sm">
    <div class="card-body">
      <% if (!appointments || appointments.length === 0) { %>
        <p class="mb-0">Hozircha uchrashuvlar yo‘q.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr>
                <th>Sana</th>
                <th>Bemor</th>
                <th>Shifokor</th>
                <th>Status</th>
                <th>Amallar</th>
              </tr>
            </thead>
            <tbody>
              <% appointments.forEach((a) => { %>
                <tr>
                  <td><%= a.appointment_date %></td>
                  <td>
                    <% if (a.patient) { %>
                      <strong><%= a.patient.name %></strong>
                      <div class="small text-muted"><%= a.patient_id %></div>
                    <% } else { %>
                      <span class="text-muted"><%= a.patient_id %></span>
                    <% } %>
                  </td>
                  <td><%= a.doctor_name %></td>
                  <td>
                    <% const badge = a.status === 'completed' ? 'success' : (a.status === 'canceled' ? 'danger' : 'warning'); %>
                    <span class="badge text-bg-<%= badge %>"><%= a.status %></span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <a href="/appointments/<%= a.id %>/edit" class="btn btn-sm btn-outline-primary">Tahrirlash</a>
                      <form action="/appointments/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Uchrashuvni o‘chirishni tasdiqlaysizmi?');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">O‘chirish</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
